/* Reverie Engine — "Ripple Lake"
   A calm lake scene: drag the pointer across the water and watch it
   refract and glint. */

scene "Ripple Lake" {
    fps = 60

    layer lake {
        type = image
        src = "assets/lake.png"
        fit = fill
    }

    layer water {
        type = ripple
        strength = 1.6
        damping = 0.08
        radius = 0.012
    }
}
