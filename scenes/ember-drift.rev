/* Reverie Engine — "Ember Drift"
   A dark, warm vignette with rising embers; clicking spawns sparks. */

scene "Ember Drift" {
    fps = 45

    layer bg {
        type = gradient
        shape = radial
        center = (0.5, 0.95)
        radius = 1.3
        stops = [#1d0b07, (#38100a 0.5), (#0a0505 1.0)]
    }

    layer glow {
        type = gradient
        shape = linear
        angle = 90
        stops = [#00000000, (#ff6a0033 0.82), (#ffb30040 1.0)]
        blend = screen
        anim opacity { from = 0.7; to = 1.0; dur = 6s; ease = sine; mode = pingpong }
    }

    layer embers {
        type = particles
        preset = embers
        spawn = both
    }
}
