/* fluid_advect_vel.comp — semi-Lagrangian self-advection of velocity with
 * damping folded in. Port of FS_FLUID_ADVECT_VEL: the field is sampled
 * BILINEARLY at the back-traced position (CLAMP_TO_EDGE), exactly like the
 * GL tier's LINEAR texture fetch.
 *
 * UBO:
 *   [0] grid (gw,gh), dt, damp
 */
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(std140, set = 0, binding = 0) uniform Params {
    vec4 p[1];
} u;

layout(set = 0, binding = 1) uniform sampler2D vel_tex;
layout(rgba16f, set = 0, binding = 9) uniform image2D vel_wr;

void main()
{
    ivec2 pc = ivec2(gl_GlobalInvocationID.xy);
    ivec2 grid = ivec2(u.p[0].xy);
    if (pc.x >= grid.x || pc.y >= grid.y)
        return;
    vec2 uv = (vec2(pc) + 0.5) / u.p[0].xy;
    vec2 vel = texture(vel_tex, uv).xy;
    vec2 back = uv - vel * u.p[0].z / (u.p[0].xy - vec2(1.0));
    vec2 adv = texture(vel_tex, back).xy * u.p[0].w;
    imageStore(vel_wr, pc, vec4(adv, 0.0, 1.0));
}
