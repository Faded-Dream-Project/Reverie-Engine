/* fluid_curl.comp — vorticity (curl) of the velocity field. Port of
 * FS_FLUID_CURL; neighbor loads clamp to the grid edge, matching the GL
 * tier's CLAMP_TO_EDGE texture sampling at border texels.
 *
 * UBO:
 *   [0] grid (gw,gh), _, _
 */
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(std140, set = 0, binding = 0) uniform Params {
    vec4 p[1];
} u;

layout(rgba16f, set = 0, binding = 8) uniform image2D vel_rd;
layout(rgba16f, set = 0, binding = 9) uniform image2D curl_wr;

vec2 loadc(ivec2 pc)
{
    ivec2 grid = ivec2(u.p[0].xy);
    return imageLoad(vel_rd, clamp(pc, ivec2(0), grid - 1)).xy;
}

void main()
{
    ivec2 pc = ivec2(gl_GlobalInvocationID.xy);
    ivec2 grid = ivec2(u.p[0].xy);
    if (pc.x >= grid.x || pc.y >= grid.y)
        return;
    vec2 r = loadc(pc + ivec2(1, 0));
    vec2 l = loadc(pc - ivec2(1, 0));
    vec2 up = loadc(pc + ivec2(0, 1));
    vec2 dn = loadc(pc - ivec2(0, 1));
    vec2 curl = vec2((r.y - l.y) - (up.x - dn.x)) * 0.5;
    imageStore(curl_wr, pc, vec4(curl, 0.0, 1.0));
}
