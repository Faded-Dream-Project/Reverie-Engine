/* fluid_jacobi.comp — one Jacobi pressure iteration (the parallel form of
 * the CPU's sequential Gauss-Seidel). Port of FS_FLUID_JACOBI: reads
 * (p, div) from the current pressure image, writes the new p into the
 * other one.
 *
 * UBO:
 *   [0] grid (gw,gh), _, _
 */
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(std140, set = 0, binding = 0) uniform Params {
    vec4 p[1];
} u;

layout(rgba16f, set = 0, binding = 8) uniform image2D press_rd;
layout(rgba16f, set = 0, binding = 9) uniform image2D press_wr;

float pload(ivec2 pc)
{
    ivec2 grid = ivec2(u.p[0].xy);
    return imageLoad(press_rd, clamp(pc, ivec2(0), grid - 1)).x;
}

void main()
{
    ivec2 pc = ivec2(gl_GlobalInvocationID.xy);
    ivec2 grid = ivec2(u.p[0].xy);
    if (pc.x >= grid.x || pc.y >= grid.y)
        return;
    float dv = imageLoad(press_rd, pc).y;
    float pl = pload(pc - ivec2(1, 0));
    float pr = pload(pc + ivec2(1, 0));
    float pd = pload(pc - ivec2(0, 1));
    float pu = pload(pc + ivec2(0, 1));
    imageStore(press_wr, pc, vec4((dv + pl + pr + pd + pu) * 0.25, dv, 0.0, 1.0));
}
