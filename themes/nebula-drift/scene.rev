/* Reverie Engine — "Nebula Drift"
   Deep space: a starfield on near-black, one huge soft nebula billowing
   slowly through it (low force, big splats, slow fade), and a faint
   distant glow. The fluid here is deliberately DIM and VAST — the opposite
   register of fluid-aurora's bright fast ribbons. */

scene "Nebula Drift" {
    fps = 60

    layer space {
        type = gradient
        shape = radial
        center = (0.5, 0.5)
        radius = 1.3
        stops = [#020208, (#070512 0.5), (#0d0a1c 0.85), (#120b24 1.0)]
    }

    layer stars {
        type = image
        src = "assets/stars.png"
        fit = fill
        opacity = 0.85
        blend = screen
        parallax = 0.03
    }

    layer far_glow {
        type = gradient
        shape = radial
        center = (0.62, 0.38)
        radius = 0.75
        stops = [(#1c2f6e26 0.0), (#1c2f6e12 0.5), #00000000]
        blend = screen
    }

    layer nebula {
        type = fluid
        res = 0.3
        dye = #6a3ad9
        dye2 = #1fb6c9
        force = 6
        radius = 0.045
        dissipation = 0.09
        ambient = 0.5
        blend = screen
        opacity = 0.5
        blur = 3
    }

    layer vignette {
        type = gradient
        shape = radial
        center = (0.5, 0.5)
        radius = 1.15
        stops = [#00000000, (#01020859 0.7), (#010208a8 1.0)]
    }
}
